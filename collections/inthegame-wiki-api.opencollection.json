            "params": [
              {
                "name": "wikiId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Remove selected wiki"
        },
        {
          "info": {
            "name": "GetAll",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/wiki/getAll",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Return wiki list"
        },
        {
          "info": {
            "name": "GetById",
            "type": "http"
          },
          "http": {
            "method": "GET",
