            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get all translation for give language"
        },
        {
          "info": {
            "name": "Update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-dev.inthegame.io/adminApi/translations/update/:key/:language",
            "params": [
