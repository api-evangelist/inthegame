{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inthegame admin translations API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "translations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/show/:language/:key",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "path"
              },
              {
                "name": "key",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get translation data for selected item"
        },
        {
          "info": {
            "name": "Add",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-dev.inthegame.io/adminApi/translations/add/:key/:language",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path"
              },
              {
                "name": "language",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "question",
                  "value": ""
                },
                {
                  "name": "options",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create translation item by generated key and language id"
        },
        {
          "info": {
            "name": "Delete",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-dev.inthegame.io/adminApi/translations/destroy/:language/:key",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "path"
              },
              {
                "name": "key",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Delete selected translation item"
        },
        {
          "info": {
            "name": "GetLanguagesList",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/translations/languagesList",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Return language codes list"
        },
        {
          "info": {
            "name": "GetAll",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/translations/list/:language",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "path"
              }
