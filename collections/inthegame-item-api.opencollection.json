          "info": {
            "name": "Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-dev.inthegame.io/adminApi/items/create",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "alias",
                  "value": ""
                },
                {
                  "name": "status",
                  "value": ""
                },
                {
                  "name": "category",
                  "value": ""
                },
                {
                  "name": "type",
                  "value": ""
                },
                {
                  "name": "image",
                  "value": ""
                },
                {
                  "name": "shortcut",
                  "value": ""
                },
                {
                  "name": "item_order",
                  "value": ""
                },
                {
                  "name": "game_id",
                  "value": ""
                },
                {
                  "name": "game",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Send new item object to save and return it as db object"
        },
        {
          "info": {
            "name": "Delete",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/items/delete/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Send item id to delete it from db"
        },
        {
          "info": {
            "name": "GetAll",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/items/getAll",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Send request to get items list by filter options"
        },
        {
          "info": {
            "name": "GetById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-dev.inthegame.io/adminApi/items/getById/:id",
