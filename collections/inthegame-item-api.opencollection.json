                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "shortcut",
                  "value": ""
                },
                {
                  "name": "item_order",
                  "value": ""
                },
                {
                  "name": "status",
                  "value": ""
                },
                {
                  "name": "type",
                  "value": ""
                },
                {
                  "name": "game_id",
                  "value": ""
                },
                {
                  "name": "thumbnail",
